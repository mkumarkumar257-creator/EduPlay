# EduPlay — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit the actual .env file — it is in .gitignore.
# On PythonAnywhere, set these in the WSGI configuration file or the
# "Environment variables" section of your web app settings.
#
# -----------------------------------------------------------------------

# Required — generate a unique secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-long-random-secret-key-here

# Set to 0 in production, 1 for local development.
DJANGO_DEBUG=0

# Comma-separated list of allowed hostnames.
# Local:      localhost,127.0.0.1
# Production: yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Comma-separated list of trusted origins for CSRF protection.
# Must include https:// and your production domain.
# Example: https://yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
